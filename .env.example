LISTEN_ADDR=:8080
SESSION_SECRET=replace-with-a-random-secret
DB_HOST=db
DB_PORT=3306
DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=replace-with-a-database-password
DB_ROOT_PASSWORD=replace-with-a-separate-root-password
WEB_PORT=8080
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
SESSION_TTL_SECONDS=28800
LOGIN_FAILURE_THRESHOLD=5
SEED_TEACHER_A_PASSWORD=replace-with-a-unique-password
SEED_STUDENT_A1_PASSWORD=replace-with-a-different-password
SEED_STUDENT_B1_PASSWORD=replace-with-another-password

# Set these to the course's OpenAI-compatible server-side gateways to enable vector search and answers.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=campusclaw_chunks
