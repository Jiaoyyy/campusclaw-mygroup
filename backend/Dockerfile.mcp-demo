FROM golang:1.24-alpine AS build
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/mcp-demo ./cmd/mcp-demo

FROM alpine:3.22
RUN addgroup -S app && adduser -S -G app app
COPY --from=build /out/mcp-demo /usr/local/bin/mcp-demo
USER app
EXPOSE 8090
CMD ["/usr/local/bin/mcp-demo"]
